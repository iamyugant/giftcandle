{
  "name": "giftcandle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node scripts/seed-fragrances.js",
    "test": "vitest run",
    "lint": "for f in server/*.js server/routes/*.js shared/*.js scripts/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@vibe/core": "^3.0.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "monday-sdk-js": "^0.5.0",
    "mongodb": "^6.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "jsdom": "^25.0.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
